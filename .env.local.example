# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# Meta App ID (Meta for Developers → App Settings → Basic). Exposed to the
# browser so the Facebook JS SDK can initialise for WhatsApp Embedded Signup.
NEXT_PUBLIC_META_APP_ID=your-meta-app-id

# Facebook Login for Business configuration ID used to launch WhatsApp
# Embedded Signup (App Dashboard → Facebook Login for Business →
# Configurations). It MUST be created from the "WhatsApp Embedded Signup"
# login variation, or from the "WhatsApp Embedded Signup Configuration With
# 60 Expiration Token" template. A generic Login for Business configuration
# signs the user in but never shows the onboarding screens, and the code it
# returns fails the token exchange with OAuthException subcode 36008.
NEXT_PUBLIC_META_ES_CONFIG_ID=your-embedded-signup-config-id

# Shared secret for the APP-LEVEL webhook subscription (App Dashboard →
# WhatsApp → Configuration → Webhooks → "Verify token" field). Generate
# with: openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=your-app-level-webhook-verify-token

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is *only* needed when the request-derived
# origin would be wrong — e.g. when generating links from a cron job
# or a background worker that has no incoming request.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# NOTE: there is deliberately no locale variable. The UI is English only.
# A NEXT_PUBLIC_* value is inlined at build time, so it could never switch
# language at runtime — see src/i18n/request.ts.

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the wacrm.tech fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
# META_APP_ID=your-meta-app-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI or Anthropic key under Settings → AI Assistant. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → AI Assistant. Still no env var required.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# ------------------------------------------------------------------
# AI connector for Claude / ChatGPT (optional, off unless all set)
# ------------------------------------------------------------------
# Remote MCP server + OAuth sign-in. See docs/ai-connector/. The feature
# stays OFF unless ENABLED is exactly "true" AND every value below is
# valid. All server-only — never prefix with NEXT_PUBLIC_.
#
# AI_CONNECTOR_ENABLED=true
# Bare origin, no trailing slash. Must equal the public URL exactly.
# AI_CONNECTOR_ISSUER=https://crm.example.com
# 32+ random characters, different per deployment (openssl rand -base64 48)
# AI_CONNECTOR_TOKEN_PEPPER=
# Only during a pepper rotation:
# AI_CONNECTOR_TOKEN_PEPPER_PREVIOUS=
# ES256 private key (JWK JSON or PEM) imported into Supabase as a JWT
# signing key, and the kid Supabase shows for it.
# AI_CONNECTOR_JWT_PRIVATE_KEY=
# AI_CONNECTOR_JWT_KID=
# Comma-separated account UUIDs; empty = every account may connect.
# AI_CONNECTOR_ALLOWED_ACCOUNTS=
# true ONLY on dev: accepts MCP Inspector and other unregistered clients.
# AI_CONNECTOR_ALLOW_DEV_CLIENTS=false
# AI_CONNECTOR_DCR_ENABLED=true
# OpenAI plugin portal domain verification token, served at /.well-known/openai-apps-challenge (unset = 404).
# OPENAI_APPS_CHALLENGE_TOKEN=
# Comma-separated kill switch, e.g. chatgpt
# AI_CONNECTOR_DISABLED_PLATFORMS=

# ------------------------------------------------------------------
# SMTP — outbound transactional email (optional but recommended)
# ------------------------------------------------------------------
# Powers every email the app sends:
#   * Super Admin → Contact → replies to contact-form submissions
#   * Billing notifications: payment received, payment approved,
#     payment rejected (src/lib/email/*)
#
# All four are read together. If SMTP_HOST, SMTP_USER or SMTP_PASS is
# missing, email is SKIPPED rather than failing — payments can still be
# submitted, approved and rejected without SMTP configured, you just
# won't get the notification. Look for "[email] ... skipped" in the
# server logs.
#
# SMTP_USER doubles as the From and Reply-To address, so use a mailbox
# someone actually reads. For Gmail/Workspace use an App Password, not
# the account password.
#
# Port 465 is implicit TLS; 587 (the default) upgrades via STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=billing@yourdomain.com
# SMTP_PASS=your-app-password
#
# The customer-facing "reply to us at" address shown in billing emails
# is NOT an env var — it comes from Super Admin → CMS → Settings
# ("support email"), falling back to SMTP_USER. Links in those emails
# use NEXT_PUBLIC_SITE_URL (above).

# ------------------------------------------------------------------
# AWS S3 — File Storage
# ------------------------------------------------------------------
# All file uploads (chat media, avatars, CMS assets, flow media) go to
# a single S3 bucket. Create an IAM user with s3:PutObject,
# s3:DeleteObject, s3:GetObject permissions on the bucket.
# AWS_S3_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ------------------------------------------------------------------
# Razorpay Subscriptions (optional; billing stays on the manual UPI flow
# until subscription_settings.payment_provider = 'razorpay').
# ------------------------------------------------------------------
# Server-only. Never prefix with NEXT_PUBLIC_: the key id reaches the
# browser through the checkout API at runtime, not the bundle.
# See docs/razopay/razorpay-subscriptions-plan.md (sections 12 and 13).
#
# The app REFUSES to use Razorpay (fails closed) when:
#   - the key prefix does not match RAZORPAY_MODE (rzp_test_ vs rzp_live_)
#   - RAZORPAY_MODE=test while BILLING_ENV=prod (test cards would buy real access)
#   - RAZORPAY_MODE=test without RAZORPAY_TEST_ALLOWED_ACCOUNT_IDS
#     (dev and prod share one database; the allowlist confines test
#     checkouts to the accounts listed, normally the demo account)
#
# RAZORPAY_MODE=test
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Webhook secret you choose in Dashboard -> Webhooks (different per mode):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# RAZORPAY_WEBHOOK_SECRET=
# Only during a webhook secret rotation (old secret, removed after 48 h):
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Comma-separated account UUIDs allowed to check out in test mode:
# RAZORPAY_TEST_ALLOWED_ACCOUNT_IDS=
# Optional live pilot: only these accounts see Razorpay checkout in live mode:
# RAZORPAY_LIVE_PILOT_ACCOUNT_IDS=
# dev | prod. Written into subscription notes; events for the other env are ignored.
# BILLING_ENV=dev
# Dev-only purchase-flow switch (manual_upi | razorpay). Ignored when
# BILLING_ENV=prod. manual_upi restores the QR flow for every account on
# this deployment; unset (or razorpay) gives allowlisted accounts Razorpay.
# Use this instead of flipping subscription_settings.payment_provider on
# dev: that flag lives in the shared database and would switch production.
# BILLING_PROVIDER_OVERRIDE=
# Currencies Razorpay can actually charge on THIS deployment (comma list of
# ISO 4217 codes). INR is always included. Add a non-INR code (e.g. USD,AED)
# only after Razorpay has activated International payments for this mode;
# until then a country priced in that currency cannot be enabled and its
# customers see the Global plan. Invalid tokens are ignored with a warning.
RAZORPAY_CHARGE_CURRENCIES=INR,USD,AED

