name: Deploy WhatsApp CRM

on:
  push:
    branches:
      - master

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: junkiescoder/wacrm

jobs:
  build-and-deploy:
    # Native ARM runner — matches EC2 aarch64 architecture
    runs-on: ubuntu-24.04-arm
    permissions:
      contents: read
      packages: write

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set short SHA
        id: vars
        run: echo "short_sha=$(git rev-parse --short HEAD)" >> "$GITHUB_OUTPUT"

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to GHCR
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push Docker image
        uses: docker/build-push-action@v6
        with:
          context: .
          platforms: linux/arm64
          push: true
          tags: |
            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:latest
            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ steps.vars.outputs.short_sha }}
          build-args: |
            NEXT_PUBLIC_SUPABASE_URL=${{ secrets.NEXT_PUBLIC_SUPABASE_URL }}
            NEXT_PUBLIC_SUPABASE_ANON_KEY=${{ secrets.NEXT_PUBLIC_SUPABASE_ANON_KEY }}
            NEXT_PUBLIC_META_APP_ID=${{ secrets.NEXT_PUBLIC_META_APP_ID }}
            NEXT_PUBLIC_META_ES_CONFIG_ID=${{ secrets.NEXT_PUBLIC_META_ES_CONFIG_ID }}
            NEXT_PUBLIC_SITE_URL=${{ secrets.NEXT_PUBLIC_SITE_URL }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      # GitHub UI Step Summary
      - name: Image build summary
        run: |
          echo "### :whale: Docker Image Built" >> $GITHUB_STEP_SUMMARY
          echo "- **Image:** \`${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:latest\`" >> $GITHUB_STEP_SUMMARY
          echo "- **Commit:** \`${{ steps.vars.outputs.short_sha }}\`" >> $GITHUB_STEP_SUMMARY

      - name: Deploy to server
        uses: appleboy/ssh-action@v1
        env:
          PROD_ENV: ${{ secrets.PROD_ENV }}
          GHCR_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GHCR_USER: ${{ github.actor }}
        with:
          host: ${{ secrets.SSH_PROD_HOST }}
          username: ${{ secrets.SSH_PROD_USER }}
          key: ${{ secrets.SSH_PROD_PRIVATE_KEY }}
          command_timeout: 10m
          envs: PROD_ENV,GHCR_TOKEN,GHCR_USER
          script: |
            set -e
            cd /opt/wacrm

            echo "==> Logging into GHCR..."
            echo "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USER" --password-stdin

            echo "==> Writing .env..."
            printf '%s\n' "$PROD_ENV" > .env
            chmod 600 .env

            # Save previous image ID for rollback
            echo "==> Saving rollback state..."
            PREV_IMAGE_ID=$(docker images ghcr.io/junkiescoder/wacrm:latest -q || echo "")

            echo "==> Pulling latest image..."
            docker compose pull wacrm

            echo "==> Starting container..."
            docker compose up -d wacrm

            # Health Check & Auto-Rollback
            echo "==> Running health check..."
            HEALTHY=false
            sleep 10

            for i in $(seq 1 10); do
              if curl -sf --max-time 10 http://localhost:3000/api/health > /dev/null 2>&1; then
                echo "✅ App is healthy! (Attempt $i)"
                HEALTHY=true
                break
              fi
              echo "  Waiting for Next.js to start... (Attempt $i/10)"
              sleep 10
            done

            if [ "$HEALTHY" = false ]; then
              echo "❌ Health check failed! Rolling back to previous version..."
              if [ -n "$PREV_IMAGE_ID" ]; then
                docker tag $PREV_IMAGE_ID ghcr.io/junkiescoder/wacrm:latest
                docker compose up -d wacrm
                echo "🔄 Rollback complete."
              else
                echo "⚠️ No previous image found to rollback to."
              fi
              exit 1
            fi

            echo "==> Cleaning up old images..."
            docker image prune -f
            echo "✅ Deployment successful!"

      # GitHub UI Deploy Summaries
      - name: Deployment summary
        if: success()
        run: |
          echo "### :white_check_mark: WhatsApp CRM Deployed to Production" >> $GITHUB_STEP_SUMMARY
          echo "- **Website:** https://wacrm.junkiescoder.com" >> $GITHUB_STEP_SUMMARY
          echo "- **Time:** $(date -u)" >> $GITHUB_STEP_SUMMARY

      - name: Deployment failed
        if: failure()
        run: |
          echo "### :x: Deployment Failed" >> $GITHUB_STEP_SUMMARY
          echo "The deployment health check failed. An automatic rollback was triggered." >> $GITHUB_STEP_SUMMARY
          echo "Please check the Action logs for error details." >> $GITHUB_STEP_SUMMARY
