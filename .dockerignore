# ===========================================
# Docker build context exclusions
# Keep the build context small and fast.
# ===========================================

# Dependencies (reinstalled inside the container)
node_modules
.pnp.*
.yarn/*

# Build output (rebuilt inside the container)
.next
out
build

# Version control
.git
.gitignore

# IDE / Editor
.vscode
.idea
*.swp
*.swo

# Environment files (mounted via env_file at runtime)
.env*
!.env.local.example
!.env.docker.example

# CI / CD
.github

# Tests & coverage
coverage
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
vitest.config.ts

# Documentation
docs
*.md
LICENSE

# Supabase local config (migrations ship, but local CLI config doesn't)
supabase/.temp

# OS junk
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.vercel
mcp-server
tsconfig.tsbuildinfo
